# ─────────────────────────────────────────────────────────
#  이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
#  .env 는 절대 공유하지 마세요 (.gitignore 에 이미 들어 있습니다)
# ─────────────────────────────────────────────────────────

# [필수] Gemini API 키 — 무료. 카드 등록 없이 1분이면 발급됩니다.
#        https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_받은_키

# [선택] 모델을 config.json 말고 여기서 바꾸고 싶을 때 (보통 비워둡니다)
# GEMINI_MODEL=gemini-2.5-flash
# 위 모델이 과부하(503)일 때 대신 써볼 모델들 (쉼표로 구분)
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash-lite

# ─── 아래는 메일 기능을 쓸 때만 ───────────────────────────
# 메일을 안 쓰면 비워두세요. 나머지 기능은 그대로 동작합니다.
# 아이디와 비밀번호는 프로토콜과 상관없이 이 두 개를 씁니다.
IMAP_USER=
IMAP_PASS=

# 서버 주소는 보통 config.json 에 두고, 여기서 덮어쓸 수도 있습니다.
#
#  하이웍스  → POP3 만 됩니다.  pop3s.hiworks.com : 995 (SSL)
#              웹메일 [메일 > 환경설정] 에서 POP3 사용을 켜고,
#              [보안 설정] 에서 '메일 전용 비밀번호' 를 따로 만들어 IMAP_PASS 에 넣으세요.
#  Gmail     → IMAP  imap.gmail.com : 993       (앱 비밀번호 필요)
#  네이버     → IMAP  imap.naver.com : 993
#  Office365 → IMAP  outlook.office365.com : 993 (기본 인증이 꺼져 있으면 안 됩니다)
#
# MAIL_PROTOCOL=auto     # auto / imap / pop3
# IMAP_HOST=
# IMAP_PORT=993
# POP3_HOST=pop3s.hiworks.com
# POP3_PORT=995
