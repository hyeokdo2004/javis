# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요. (.env 는 공유하지 마세요)

# ── Gemini ────────────────────────────────────────────────
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_받은_키

# 모델을 코드/설정 대신 여기서 강제하고 싶을 때만 씁니다 (보통 비워둡니다)
# GEMINI_MODEL=gemini-2.5-flash
# 위 모델이 과부하(503)일 때 대신 써볼 모델들 (쉼표로 구분)
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash-lite

# ── 메일 (안 쓰면 비워두세요) ─────────────────────────────
# 하이웍스: mail.hiworks.co.kr / 지메일: imap.gmail.com / 네이버: imap.naver.com
# IMAP_HOST=mail.hiworks.co.kr
# IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
